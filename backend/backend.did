type Token =
 record {
   ledger: principal;
   market: principal;
   symbol: text;
 };
type Stat =
 record {
   count: nat;
   liked: bool;
 };
type Result_2 =
 variant {
   err: PaymentError;
   ok: Purchase;
 };
type Result_1 =
 variant {
   err: PaymentError;
   ok;
 };
type Result =
 variant {
   err: PaymentError;
   ok: nat;
 };
type Reference =
 record {
   icp: nat;
   token: nat;
 };
type Quote =
 record {
   approvalFee: nat;
   listing: Listing;
   paymentFee: nat;
   payoutFee: nat;
   sellerReceives: nat;
   totalDebit: nat;
 };
type Purchase =
 record {
   amountE8s: opt nat;
   amountEur: nat;
   artTier: opt nat;
   attempts: nat;
   caller: principal;
   checkoutUrl: opt text;
   createdAt: int;
   fulfillment: Fulfillment;
   id: text;
   invoiceId: opt text;
   lastError: opt text;
   ledgerBlock: opt nat;
   lucky: bool;
   method: Method;
   nextCheck: int;
   nftId: opt nat;
   payTime: opt nat64;
   paymentStatus: text;
   sandbox: bool;
   seed: opt blob;
   sequence: nat;
   tier: nat;
   updatedAt: int;
 };
type Phase =
 variant {
   active;
   cancelled;
   cancelling;
   collecting;
   delivering;
   locking;
   paying;
   review;
   sold;
 };
type PaymentError =
 variant {
   forbidden;
   rejected: text;
   unauthorized;
 };
type MintDetails =
 record {
   artTier: opt nat;
   creator: principal;
   lucky: bool;
   nftId: nat;
   price: opt variant {
                eur: nat;
                icp: nat;
                token: nat;
              };
   testMint: bool;
 };
type Method =
 variant {
   icp;
   paw;
   token;
 };
type Listing =
 record {
   appFee: nat;
   buyer: opt principal;
   createdAt: int;
   currency: Currency;
   deliveryBlock: opt nat;
   error: opt text;
   fee: nat;
   feeBlock: opt nat;
   feeTime: opt nat64;
   id: nat;
   ledger: principal;
   nftId: nat;
   payTime: opt nat64;
   paymentBlock: opt nat;
   paymentUncertain: bool;
   payoutBlock: opt nat;
   payoutTime: opt nat64;
   payoutUncertain: bool;
   phase: Phase;
   price: nat;
   proceeds: nat;
   revision: nat;
   seller: principal;
   sweepFee: opt nat;
   updatedAt: int;
 };
type HttpRequestResult =
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader =
 record {
   name: text;
   value: text;
 };
type Fulfillment =
 variant {
   awaiting;
   closed;
   creating;
   minted;
   minting;
   paid;
   review;
 };
type Currency =
 variant {
   icp;
   token;
 };
type Account =
 record {
   owner: principal;
   subaccount: opt blob;
 };
service : {
  attachPawInvoice: (id: text, invoiceId: text) -> (Result_1);
  buyBonsai: (id: nat, revision: nat, expectedFee: nat) ->
   (variant {
      err: text;
      ok: Listing;
    });
  buyWithIcp: (icp: nat) -> (Result_2);
  buyWithToken: (tokens: nat) -> (Result_2);
  cancelListing: (id: nat) -> (variant {
                                 err: text;
                                 ok: Listing;
                               });
  claimMarketFee: (id: nat) -> (variant {
                                  err: text;
                                  ok: nat;
                                });
  closeUnknownPurchase: (id: text, reason: text) -> (Result_1);
  configurePaw: (key: text, usdcAsset: text, redirect: text, sandbox:
   bool) -> (Result_1);
  createPurchase: (eur: nat) -> (Result_2);
  getMintDetails: (keys: vec text) -> (vec opt MintDetails) query;
  getMyPurchases: () -> (vec Purchase) query;
  /// Like counts for up to 100 bonsai, plus whether the caller liked each.
  likeStats: (ids: vec nat) -> (vec Stat) query;
  listBonsai: (nftId: nat, currency: Currency, price: nat) ->
   (variant {
      err: text;
      ok: Listing;
    });
  marketListings: (ids: vec nat) -> (vec opt Listing) query;
  marketPolicy: () ->
   (record {
      feeBps: nat;
      maxMultiple: nat;
      token: opt Token;
    }) query;
  marketQuote: (id: nat) -> (variant {
                               err: text;
                               ok: Quote;
                             });
  mintReferences: (keys: vec text) -> (vec opt Reference) query;
  myMarketActivity: (before: opt nat) -> (vec Listing) query;
  paymentInfo: () ->
   (record {
      asset: text;
      configured: bool;
      mock: bool;
      pending: nat;
      sandbox: bool;
    }) query;
  pricing: () ->
   (record {
      maxEur: nat;
      maxIcp: nat;
      maxToken: nat;
      minEur: nat;
      minIcp: nat;
      minToken: nat;
      tiers: vec record {
                   eur: nat;
                   icp: nat;
                   name: text;
                   token: nat;
                 };
      token: opt Token;
    }) query;
  reconciliationQueue: () -> (vec Purchase) query;
  refreshPurchase: (id: text) -> (Result_2);
  retryMarket: (id: nat) -> (variant {
                               err: text;
                               ok: Listing;
                             });
  /// Idempotently likes (`liked = true`) or unlikes a bonsai for the signed-in caller.
  setLike: (nftId: nat, liked: bool) -> (variant {
                                           err: text;
                                           ok: Stat;
                                         });
  setTierPrices: (method: Method, anchors: vec nat) -> (Result_1);
  setToken: (token: opt Token) -> (Result_1);
  tokenStats: () ->
   (record {
      buyers: nat;
      collectedE8s: nat;
      mints: nat;
    }) query;
  transformPawStatus: (args:
   record {
     context: blob;
     response: HttpRequestResult;
   }) -> (HttpRequestResult) query;
  withdrawIcp: (to: Account, amount: nat) -> (Result);
  withdrawToken: (to: Account, amount: nat) -> (Result);
}
